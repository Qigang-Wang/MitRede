{
  "name": "mitrede",
  "version": "0.2.0",
  "private": true,
  "description": "Interaktive PDF-Präsentationen für Meetings, Schulungen und Workshops",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @mitrede/web --filter @mitrede/api dev",
    "dev:web": "pnpm --filter @mitrede/web dev",
    "dev:api": "pnpm --filter @mitrede/api dev",
    "dev:worker": "pnpm --filter @mitrede/worker dev",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm --filter @mitrede/contracts build && pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @mitrede/api prisma:generate",
    "db:migrate": "pnpm --filter @mitrede/api prisma:migrate",
    "infra:up": "docker compose up -d postgres redis minio",
    "infra:down": "docker compose down"
  }
}
